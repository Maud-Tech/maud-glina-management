{
  "openapi": "3.1.0",
  "info": {
    "title": "Maud · Glina · Gestão",
    "version": "1",
    "description": "App de gestão da arquitetura Glina: sabe o que existe e quanto vale. Não conhece cliente."
  },
  "paths": {
    "/api/v1/example/items": {
      "post": {
        "operationId": "example_post_item",
        "summary": "Cadastrar item",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          }
        },
        "tags": [
          "example"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      },
      "get": {
        "operationId": "example_get_items",
        "summary": "Listar itens",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "include_inactive",
            "schema": {
              "default": false,
              "title": "Include Inactive",
              "type": "boolean"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemListItem"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "example"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ItemResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "is_active"
        ],
        "title": "ItemResponse",
        "type": "object"
      },
      "CreateItemRequest": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateItemRequest",
        "type": "object"
      },
      "ItemListItem": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "is_active"
        ],
        "title": "ItemListItem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    }
  },
  "servers": []
}