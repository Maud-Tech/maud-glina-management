# Copie para .env. Valores de DESENVOLVIMENTO; produção usa segredos do ambiente (cofre de segredos).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=maud_glina_management
POSTGRES_USER=maud
POSTGRES_PASSWORD=maud
# Chaves aceitas no header X-Api-Key (separadas por vírgula). Em DEBUG, "dev-key" é aceita se vazio.
MAUD_API_KEYS=
# Webhook de saída (avisos do outbox). Vazio = avisos ficam na fila até configurar.
WEBHOOK_URL=
WEBHOOK_SECRET=
