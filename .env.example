# Copie para .env. Valores de DESENVOLVIMENTO; produção usa segredos do ambiente (cofre de segredos).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Só se acessar por https na frente de um proxy (ex.: https://maud-server.xxx.ts.net:8443). Vazio no local.
DJANGO_CSRF_TRUSTED_ORIGINS=
# 127.0.0.1, não "localhost": o banco só escuta no IPv4 local, e no Windows "localhost" tenta o IPv6 (::1) antes e trava.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
# Porta da API e das telas (a mesma dentro e fora do container).
API_PORT=8080
POSTGRES_DB=maud_glina_management
POSTGRES_USER=maud
POSTGRES_PASSWORD=maud
# Chaves aceitas no header X-Api-Key (separadas por vírgula). Em DEBUG, "dev-key" é aceita se vazio.
MAUD_API_KEYS=
# Webhook de saída (avisos do outbox). Vazio = avisos ficam na fila até configurar.
WEBHOOK_URL=
WEBHOOK_SECRET=
